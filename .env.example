# Core infrastructure
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/capstack?sslmode=require"
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"
CORS_EXTRA_ORIGINS=""
RATE_LIMIT_WINDOW_MS="60000"

# Public app configuration
NEXT_PUBLIC_API_URL="http://localhost:3000"
SESSION_TIMEOUT_HOURS="8"
NEXT_PUBLIC_OPS_AUTH_MODE="demo"
NEXT_PUBLIC_OPS_SSO_PROVIDERS=""

# Workers / model serving
WORKERS_PORT="3010"
CREDIT_MODEL_URL="http://localhost:8000/predict"

# Auth / webhooks
CLERK_WEBHOOK_SECRET=""
# Required in production for signed ops sessions and ops -> api bearer tokens.
# Use the same strong random value in both the ops and api deployments.
OPS_INTERNAL_AUTH_SECRET=""
# Optional legacy IdP start URLs if auth is initiated outside Capstack.
OPS_SSO_GOOGLE_START_URL=""
OPS_SSO_MICROSOFT_START_URL=""
OPS_SSO_GOOGLE_CLIENT_ID=""
OPS_SSO_GOOGLE_CLIENT_SECRET=""
OPS_SSO_GOOGLE_HOSTED_DOMAIN=""
OPS_SSO_MICROSOFT_CLIENT_ID=""
OPS_SSO_MICROSOFT_CLIENT_SECRET=""
OPS_SSO_MICROSOFT_TENANT_ID="organizations"

# Document storage (Cloudflare R2 / S3-compatible)
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY=""
R2_SECRET_KEY=""
R2_BUCKET="capstack-documents"

# Payments / collections
PAYFAST_MERCHANT_ID=""
PAYFAST_MERCHANT_KEY=""
PAYFAST_PASSPHRASE=""
PAYFAST_TESTING_MODE="true"
STRIPE_SECRET_KEY=""

# Notifications
NOTIFICATION_DELIVERY_MODE="stub"
CLICKATELL_API_KEY=""
CLICKATELL_SENDER_ID="Capstack"
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Capstack <noreply@capstack.co.za>"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_NUMBER=""

# KYC / identity / bureau integrations
# Optional until the client provides live provider credentials.
SMILE_ID_PARTNER_ID=""
SMILE_ID_API_KEY=""
SMILE_ID_SID_SERVER=""
ONFIDO_API_TOKEN=""
BUREAU_MODE="mock"
BUREAU_PROVIDER="EXPERIAN"
EXPERIAN_BASE_URL="https://api.experian.co.za"
EXPERIAN_CLIENT_ID=""
EXPERIAN_CLIENT_SECRET=""
EXPERIAN_AUTH_PATH="/oauth/token"
EXPERIAN_SOFT_PULL_PATH="/v1/credit-report/soft-pull"
EXPERIAN_API_KEY=""
EXPERIAN_API_KEY_HEADER="x-api-key"
TRANSUNION_BASE_URL=""
TRANSUNION_CLIENT_ID=""
TRANSUNION_CLIENT_SECRET=""
TRANSUNION_AUTH_PATH=""
TRANSUNION_SOFT_PULL_PATH=""
TRANSUNION_API_KEY=""
TRANSUNION_API_KEY_HEADER="x-api-key"
XDS_BASE_URL="https://api.xds.co.za"
XDS_CLIENT_ID=""
XDS_CLIENT_SECRET=""
XDS_AUTH_PATH=""
XDS_SOFT_PULL_PATH=""
XDS_API_KEY=""
XDS_API_KEY_HEADER="x-api-key"
AFRIGIS_BASE_URL="https://afrigis.co.za/api"
AFRIGIS_API_KEY=""
